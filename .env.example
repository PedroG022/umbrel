# ==============================================================================
# Umbrel Configuration
# ==============================================================================
# Operation Mode: 1 (local), 2 (private-domain), 3 (tailscale)
OPERATION_MODE=1

# ------------------------------------------------------------------------------
# Mode 1: Local Network (mDNS - umbrel.local)
# ------------------------------------------------------------------------------
LOCAL_HOSTNAME=umbrel
LOCAL_DOMAIN=local
AVAHI_INTERFACE=eth0

# ------------------------------------------------------------------------------
# Mode 2: Private Domain via VPN (e.g. umbrel.my.domain with Let's Encrypt DNS-01)
# ------------------------------------------------------------------------------
DOMAIN=example.com
SUBDOMAIN=c
DNS_PROVIDER=hostinger          # hostinger, cloudflare, etc.
API_TOKEN=your_dns_api_token
ACME_EMAIL=admin@example.com
RECORD_CONTENT=100.116.88.41    # Private VPN IP (e.g. Tailscale / WireGuard)
RECORD_TYPE=A
RECORD_TTL=300
OVERWRITE=true

# ------------------------------------------------------------------------------
# Mode 3: Tailscale MagicDNS (*.ts.net)
# ------------------------------------------------------------------------------
TAILSCALE_HOSTNAME=umbrel
TAILNET_NAME=your-tailnet.ts.net

# ------------------------------------------------------------------------------
# Traefik & SSL / TLS Engine Flags (Auto-configured by ./setup.sh)
# ------------------------------------------------------------------------------
TRAEFIK_HOST_RULE="Host(`umbrel.local`)"
TRAEFIK_ENTRYPOINTS=web
APP_ENTRYPOINTS=web
APP_ENABLE_TLS=false
ENABLE_TLS=false
ENABLE_ACME_DNS=false
TLS_CERT_RESOLVER=
TLS_DOMAIN_MAIN=
TLS_DOMAIN_SANS=